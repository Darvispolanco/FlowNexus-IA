# ==========================================
# FLOWNEXUS AI - CONFIGURACIÓN
# ==========================================

# API del proveedor de inteligencia artificial
OPENAI_API_KEY=tu_api_key_aqui

# Modelo que utilizará FlowNexus
OPENAI_MODEL=gpt-5.6

# Configuración general
FLOWNEXUS_NAME=FlowNexus
FLOWNEXUS_ENV=development

# Directorios
WORKSPACE_DIR=workspace
MEMORY_DIR=memory

# Investigación web
MAX_SEARCH_RESULTS=5
REQUEST_TIMEOUT=15
